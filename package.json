{
  "name": "techbazaar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace=@techbazaar/api run dev",
    "dev:web": "npm --workspace=@techbazaar/web run dev",
    "client": "npm run dev:web",
    "server": "npm run dev:api",
    "build": "npm --workspace=@techbazaar/web run build",
    "preview": "npm --workspace=@techbazaar/web run preview",
    "seed": "npm --workspace=@techbazaar/api run seed",
    "migrate": "npm --workspace=@techbazaar/api run migrate",
    "images": "node scripts/optimize-images.mjs",
    "backup": "node scripts/backup-db.mjs",
    "test": "vitest run",
    "test:web": "vitest run apps/web/tests",
    "test:api": "vitest run apps/api/tests",
    "test:e2e": "playwright test --config e2e/playwright.config.js",
    "lint": "eslint apps/web/src apps/api",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "framer-motion": "^14.14.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.1",
    "vitest": "^5.1.1"
  }
}
